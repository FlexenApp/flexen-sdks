{
  "name": "@flexen/api",
  "version": "0.1.0",
  "description": "Official TypeScript client for the Flexen API (nutrition from text and photos, food search, barcode, goals, catalog, account).",
  "license": "MIT",
  "author": "Flexen UG (haftungsbeschränkt)",
  "homepage": "https://flexen.co/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlexenApp/flexen-sdks.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "email": "support@flexen.co"
  },
  "keywords": [
    "flexen",
    "nutrition",
    "calories",
    "food",
    "barcode",
    "api",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
